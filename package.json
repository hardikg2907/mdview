{
  "name": "@hardikg/mdview",
  "version": "0.10.0",
  "description": "Local CLI markdown viewer with live reload, outline navigation, and folder browsing",
  "license": "MIT",
  "author": "Hardik Garg <hardikg2907@gmail.com>",
  "keywords": [
    "markdown",
    "md",
    "viewer",
    "cli",
    "live-reload",
    "preview",
    "docs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hardikg2907/mdview.git"
  },
  "homepage": "https://github.com/hardikg2907/mdview#readme",
  "bugs": {
    "url": "https://github.com/hardikg2907/mdview/issues"
  },
  "type": "module",
  "bin": {
    "mdview": "./bin/mdview.mjs"
  },
  "files": [
    "bin/*.mjs",
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev:client": "vite",
    "build:client": "vite build",
    "build:server": "tsup",
    "build": "npm run build:client && npm run build:server",
    "start": "node bin/mdview.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "lint": "biome check src tests build",
    "lint:fix": "biome check --write src tests build",
    "capture": "node scripts/capture-screenshots.mjs",
    "prepack": "node -e \"require('fs').rmSync('bin',{recursive:true,force:true})\" && npm run build",
    "prepare": "husky || true && node -e \"const fs=require('fs');if(!fs.existsSync('bin/mdview.mjs'))require('child_process').execSync('npm run build',{stdio:'inherit'})\""
  },
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "chokidar": "^4.0.1",
    "fastify": "^5.12.7",
    "js-yaml": "^5.5.0",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "open": "^11.0.4",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@preact/signals": "^2.11.3",
    "@types/node": "^22.20.5",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "katex": "^0.19.1",
    "pele": "^1.10.0",
    "preact": "^10.29.8",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "ws": ">=8.20.1"
  },
  "engines": {
    "node": ">=20"
  }
}
