{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "apps/vscode:watch",
      "type": "shell",
      "command": "npm run watch",
      "options": {
        "cwd": "${workspaceFolder}/apps/vscode",
        "env": { "NODE_ENV": "development" }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "esbuild",
        "fileLocation": ["relative", "${workspaceFolder}/apps/vscode"],
        "pattern": [
          { "regexp": "^✘ \\[ERROR\\] (.+)$", "message": 1 },
          { "regexp": "^\\s+(\\S.*):(\\d+):(\\d+):$", "file": 1, "line": 2, "column": 3 }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[watch\\] build started$",
          "endsPattern": "^\\[watch\\] build finished$"
        }
      }
    }
  ]
}
